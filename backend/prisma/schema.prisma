generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Enums audit operation and unit of measurement for materials
enum AuditOperation {
  INCREMENT
  DECREMENT
  SET
}

// Unit of measurement for materials
enum Unit {
  PCS
  BOX
  ROLL
  PACK
  PAIR
  OTHER
}

// Role model representing user roles in the system
// Each role has a unique name and an optional description, and can be associated with multiple users.
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// User model representing users in the system
// Each user has a unique username, a hashed password, and is associated with a role.
model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String

  isActive Boolean @default(true)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions Session[]
  changes  InventoryChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
}

// Session model representing user sessions in the system
// Each session is associated with a user and has an expiration time, creation time, and last
model Session {
  id     String @id
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Category model representing categories of materials in the system
// Each category has a unique name and an optional description, and can be associated with multiple materials
model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Material model representing materials in the system
// Each material has a name, description, unit of measurement, minimum quantity, and is associated
// with a category. Materials can have an inventory record and multiple inventory changes.
model Material {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  unit Unit @default(PCS)

  minimumQuantity Int @default(0)

  isActive Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  inventory Inventory?
  changes   InventoryChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

// Inventory model representing the current inventory of materials in the system
// Each inventory record is associated with a material and tracks the quantity and version of the inventory.
model Inventory {
  id Int @id @default(autoincrement())

  materialId Int      @unique
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  quantity Int @default(0)
  version  Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// InventoryChange model representing changes to the inventory of materials in the system
// Each inventory change is associated with a user and a material, and tracks the old quantity,
model InventoryChange {
  id BigInt @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  oldQuantity Int
  newQuantity Int
  difference  Int

  operation AuditOperation

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([materialId, createdAt])
  @@index([createdAt])
}

// SystemSetting model representing system-wide settings in the system
// Each system setting has a unique key, a value, and an optional description.
model SystemSetting {
  id          Int      @id @default(autoincrement())

  key         String   @unique
  value       String

  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}